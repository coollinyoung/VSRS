<Project Sdk="Microsoft.NET.Sdk">
  <!-- 維護要點：維持 x64，Services.cs 的原生結構偏移以 x64 為準。
       自包含不代表完全不依賴 Windows DLL；PE 仍需提供磁碟及桌面 API。 -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VSRS</RootNamespace>
    <AssemblyName>VSRS</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>recovery.ico</ApplicationIcon>

    <!-- WinPE：將 .NET 8 Runtime 封裝進單一 x64 EXE，不需在 PE 安裝 .NET。 -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <!-- EXE 檔案圖示由 ApplicationIcon 提供；視窗圖示由內嵌資源提供。 -->
  <ItemGroup>
    <EmbeddedResource Include="recovery.ico" LogicalName="VSRS.recovery.ico" />
  </ItemGroup>
</Project>
